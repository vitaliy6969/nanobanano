# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Nanobanano/APIyi API Configuration (OpenAI Images API compatible)
NANOBANANO_API_KEY=your_apiyi_api_key_here
NANOBANANO_API_URL=https://api.apiyi.com/v1
NANOBANANO_MODEL=nano-banana-pro

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_image_hub

# Application Security
API_SECRET_TOKEN=your_secret_api_token_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
